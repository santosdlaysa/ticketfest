# ===========================================
# CONFIGURAÇÃO DA APLICAÇÃO MOBILE (REACT NATIVE)
# ===========================================

# URL da API do backend
# IMPORTANTE: Para testar em dispositivos físicos, use o IP da sua máquina na rede local
# Para emulador Android: use 10.0.2.2
# Para emulador iOS ou Expo Go: use o IP local da sua máquina (ex: 192.168.1.100)
# Em produção: use a URL pública da sua API
API_URL=https://ticketfest-wf2z.onrender.com/api

# URL base da API (sem o /api no final) - usado para algumas requisições específicas
BASE_URL=https://ticketfest-wf2z.onrender.com


# ===========================================
# CONFIGURAÇÃO DE AMBIENTE
# ===========================================

# Ambiente de execução (development, staging, production)
NODE_ENV=development


# ===========================================
# CONFIGURAÇÕES OPCIONAIS
# ===========================================

# Habilitar modo mock (true = usa dados mockados, false = usa API real)
# Útil para desenvolvimento sem conexão com o backend
USE_MOCK_DATA=false

# Timeout para requisições HTTP em milissegundos (padrão: 30000 = 30 segundos)
API_TIMEOUT=30000


# ===========================================
# CONFIGURAÇÃO DO SENTRY (MONITORAMENTO DE ERROS)
# ===========================================
# Monitora erros em produção e ajuda a debugar problemas
# Para instalar: npm install @sentry/react-native

# IMPORTANTE: Para React Native com Expo, a configuração do DSN é feita no app.json
# Edite o arquivo app.json e substitua o valor de "extra.sentryDsn":
#
# "extra": {
#   "sentryDsn": "https://your-dsn@sentry.io/project"
# }

# Para upload de source maps, configure estas variáveis:
SENTRY_AUTH_TOKEN=your-auth-token
SENTRY_ORG=your-organization-slug
SENTRY_PROJECT=lumera-mobile

EXPO_PUBLIC_SENTRY_DSN=https://8add2613e63dca366002af5a04d38acf@o4510602903158784.ingest.us.sentry.io/4510602909843456

# ===========================================
# OBSERVAÇÕES IMPORTANTES
# ===========================================

# 1. React Native não suporta nativamente arquivos .env
#    Para usar variáveis de ambiente, você precisa instalar uma biblioteca como:
#    - react-native-dotenv
#    - react-native-config
#
#    Recomendação: react-native-dotenv (mais simples para projetos Expo)
#    Instalação: npm install --save-dev react-native-dotenv

# 2. Após instalar react-native-dotenv, configure o babel.config.js:
#    plugins: [
#      ['module:react-native-dotenv', {
#        moduleName: '@env',
#        path: '.env',
#      }]
#    ]

# 3. Para usar as variáveis no código:
#    import { API_URL, BASE_URL } from '@env';

# 4. Como descobrir o IP da sua máquina:
#    - Windows: abra o CMD e digite "ipconfig", procure por "IPv4 Address"
#    - Mac/Linux: abra o Terminal e digite "ifconfig" ou "ip addr"
#    - Ou use o Expo: ao rodar "npm start", o IP aparecerá no terminal

# 5. Lembre-se de adicionar .env ao .gitignore para não commitar suas configurações locais

# 6. Para diferentes ambientes, você pode criar:
#    - .env.development (desenvolvimento)
#    - .env.staging (homologação)
#    - .env.production (produção)
