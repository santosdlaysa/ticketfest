# ===========================================
# CONFIGURAÇÃO DO SERVIDOR
# ===========================================

# Ambiente de execução (development, production, test)
NODE_ENV=development

# Porta onde o servidor vai rodar
PORT=3000

# URL da API (usado para links em emails e integrações)
API_URL=http://localhost:3000


# ===========================================
# CONFIGURAÇÃO DO BANCO DE DADOS PRINCIPAL
# ===========================================

# Host do banco de dados PostgreSQL
DB_HOST=localhost

# Porta do PostgreSQL (padrão: 5432)
DB_PORT=5432

# Usuário do banco de dados
DB_USER=postgres

# Senha do banco de dados
DB_PASSWORD=sua_senha_aqui

# Nome do banco de dados
DB_NAME=ticketfest

# URL completa de conexão do banco (opcional - será construída automaticamente se não fornecida)
# Formato: postgresql://usuario:senha@host:porta/database?schema=public
# DATABASE_URL=postgresql://postgres:sua_senha_aqui@localhost:5432/ticketfest?schema=public


# ===========================================
# CONFIGURAÇÃO DE FAILOVER - SUPABASE
# ===========================================
# Configure para ter alta disponibilidade
# Se o banco primário cair, usa automaticamente o Supabase como backup

# Habilitar failover automático para Supabase em caso de falha do banco principal
DB_FAILOVER_ENABLED=true

# Intervalo de verificação de saúde do banco (em milissegundos, padrão: 30000 = 30 segundos)
DB_HEALTH_CHECK_INTERVAL=30000

# URL pública do projeto Supabase (opcional - para usar a API do Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública do Supabase (opcional - para usar a API do Supabase)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sua_chave_publica_supabase

# Host do banco de dados Supabase (obtenha em Project Settings > Database)
# Formato: db.sua-referencia.supabase.co
SUPABASE_DB_HOST=db.seu-projeto.supabase.co

# Porta do banco Supabase (padrão: 5432)
SUPABASE_DB_PORT=5432

# Usuário do banco Supabase (geralmente 'postgres')
SUPABASE_DB_USER=postgres

# Senha do banco Supabase (obtenha em Project Settings > Database)
SUPABASE_DB_PASSWORD=sua_senha_supabase

# Nome do banco Supabase (padrão: postgres)
SUPABASE_DB_NAME=postgres

# URL completa de conexão do Supabase (opcional - será construída automaticamente)
# SUPABASE_DATABASE_URL=postgresql://postgres:senha@db.projeto.supabase.co:5432/postgres


# ===========================================
# CONFIGURAÇÃO DE AUTENTICAÇÃO JWT
# ===========================================

# Chave secreta para assinar tokens JWT (mínimo 32 caracteres)
# IMPORTANTE: Gere uma chave forte e única para produção
# Você pode gerar uma chave segura em: https://generate-secret.vercel.app/32
JWT_SECRET=gere_uma_chave_secreta_forte_e_aleatoria_aqui_minimo_32_caracteres

# Chave secreta para tokens de refresh (mínimo 32 caracteres)
# IMPORTANTE: Deve ser diferente do JWT_SECRET
JWT_REFRESH_SECRET=gere_outra_chave_secreta_diferente_aqui_minimo_32_caracteres

# Tempo de expiração do token de acesso (ex: 15m, 1h, 1d)
JWT_EXPIRES_IN=15m

# Tempo de expiração do refresh token (ex: 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d


# ===========================================
# CONFIGURAÇÃO DE EMAIL (SMTP)
# ===========================================

# Servidor SMTP (ex: smtp.gmail.com, smtp-mail.outlook.com)
SMTP_HOST=smtp.gmail.com

# Porta do servidor SMTP (587 para TLS, 465 para SSL)
SMTP_PORT=587

# Usar conexão segura (true para SSL na porta 465, false para STARTTLS na porta 587)
SMTP_SECURE=false

# Email/usuário para autenticação no SMTP
SMTP_USER=seu-email@gmail.com

# Senha do email ou App Password
# Para Gmail: crie um App Password em https://myaccount.google.com/apppasswords
SMTP_PASSWORD=sua_senha_ou_app_password

# Email remetente que aparecerá nos emails enviados
EMAIL_FROM=noreply@ticketfest.com


# ===========================================
# CONFIGURAÇÃO DE PAGAMENTOS - STRIPE (LEGACY)
# ===========================================
# O Stripe está configurado mas não é mais o gateway principal
# O sistema usa Pagar.me para pagamentos no Brasil

# Chave secreta do Stripe (sk_test_ para testes, sk_live_ para produção)
STRIPE_SECRET_KEY=sk_test_sua_chave_secreta_stripe

# Secret do webhook do Stripe para validar eventos
STRIPE_WEBHOOK_SECRET=whsec_seu_webhook_secret

# Chave pública do Stripe (pk_test_ para testes, pk_live_ para produção)
STRIPE_PUBLISHABLE_KEY=pk_test_sua_chave_publica_stripe


# ===========================================
# CONFIGURAÇÃO DE PAGAMENTOS - PAGAR.ME
# ===========================================
# Gateway de pagamento brasileiro (PIX, Cartão de Crédito, Boleto)
# Obtenha suas chaves em: https://dash.pagar.me/

# Chave secreta do Pagar.me (sk_test_ para testes, sk_live_ para produção)
PAGARME_SECRET_KEY=sk_test_sua_chave_secreta_pagarme

# Chave pública do Pagar.me (pk_test_ para testes, pk_live_ para produção)
PAGARME_PUBLIC_KEY=pk_test_sua_chave_publica_pagarme

# Secret do webhook do Pagar.me para validar eventos (opcional)
PAGARME_WEBHOOK_SECRET=seu_webhook_secret_pagarme


# ===========================================
# CONFIGURAÇÃO AWS S3 (UPLOAD DE IMAGENS)
# ===========================================
# Opcional - para armazenar imagens de eventos e avatares

# ID da chave de acesso AWS (obtenha no IAM)
AWS_ACCESS_KEY_ID=sua_access_key_id

# Chave secreta de acesso AWS
AWS_SECRET_ACCESS_KEY=sua_secret_access_key

# Região do bucket S3 (ex: us-east-1, sa-east-1 para São Paulo)
AWS_REGION=us-east-1

# Nome do bucket S3 para armazenar uploads
AWS_BUCKET_NAME=ticketfest-uploads


# ===========================================
# CONFIGURAÇÃO DE CORS
# ===========================================

# URL do frontend para configuração de CORS
# Em desenvolvimento: use localhost com a porta do frontend
# Em produção: use o domínio público do frontend
# Para múltiplas URLs, separe com vírgula
FRONTEND_URL=https://lumerafest.online


# ===========================================
# CONFIGURAÇÃO DE RATE LIMITING
# ===========================================
# Proteção contra abuso de API

# Janela de tempo para rate limiting em milissegundos (padrão: 900000 = 15 minutos)
RATE_LIMIT_WINDOW_MS=900000

# Número máximo de requisições por janela de tempo (por IP)
RATE_LIMIT_MAX_REQUESTS=100


# ===========================================
# CONFIGURAÇÃO DO SENTRY (MONITORAMENTO DE ERROS)
# ===========================================
# Monitora erros em produção e ajuda a debugar problemas

# DSN do Sentry - obtenha em https://sentry.io/settings/projects/
# Este é o identificador único do seu projeto no Sentry
# Formato: https://<key>@<org-id>.ingest.us.sentry.io/<project-id>
SENTRY_DSN=https://your-key@your-org.ingest.us.sentry.io/your-project-id
