# Server Configuration
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database Configuration
# Preencha as variáveis abaixo - a URL será construída automaticamente
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=ticketfest

# OU defina a DATABASE_URL diretamente (descomente a linha abaixo):
# DATABASE_URL=postgresql://user:password@localhost:5432/ticketfest?schema=public

# Supabase API (opcional)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# DATABASE FAILOVER - Supabase como Backup
# ============================================
# Configure para ter alta disponibilidade
# Se o banco primario cair, usa automaticamente o Supabase

# Conexao Supabase Database (obtenha em Project Settings > Database)
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password
SUPABASE_DB_NAME=postgres
# OU use a connection string direta:
# SUPABASE_DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# Configuracao do Failover
DB_FAILOVER_ENABLED=true
DB_HEALTH_CHECK_INTERVAL=30000

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@Lumera.com

# Stripe Payment Gateway (legacy)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Pagar.me Payment Gateway (PIX e Cartao)
# Obtenha suas chaves em: https://dash.pagar.me/
PAGARME_SECRET_KEY=sk_test_your_pagarme_secret_key
PAGARME_PUBLIC_KEY=pk_test_your_pagarme_public_key
PAGARME_WEBHOOK_SECRET=your_webhook_secret

# AWS S3 (Optional - for image uploads)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=Lumera-uploads

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
