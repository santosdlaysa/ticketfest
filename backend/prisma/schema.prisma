// Prisma Schema for Lumera
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  cpf          String?  @unique
  phone        String?
  role         Role     @default(USER)

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  orders       Order[]
  events       Event[]  @relation("EventOrganizer")
  venues       Venue[]  @relation("VenueOrganizer")
  refreshTokens RefreshToken[]
  organizerAccount OrganizerAccount?

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum Role {
  USER
  ADMIN
  ORGANIZER
}

// ============================================
// VENUES
// ============================================

model Venue {
  id          String   @id @default(uuid())
  name        String
  address     String
  city        String
  state       String
  zipCode     String?  @map("zip_code")
  latitude    Float?
  longitude   Float?
  capacity    Int?
  description String?  @db.Text
  images      String[] @default([])
  phone       String?
  email       String?

  // Owner
  organizerId String   @map("organizer_id")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  organizer   User     @relation("VenueOrganizer", fields: [organizerId], references: [id])
  events      Event[]

  @@index([organizerId])
  @@map("venues")
}

// ============================================
// EVENTS
// ============================================

model Event {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  description String      @db.Text
  date        DateTime
  endDate     DateTime?   @map("end_date")

  // Location (legacy fields kept for compatibility)
  location    String
  address     String
  latitude    Float?
  longitude   Float?

  // Venue relation (optional, new)
  venueId     String?     @map("venue_id")

  // Media
  images      String[]    @default([])

  // Categorization
  category    String

  // Status
  status      EventStatus @default(DRAFT)

  // Organizer
  organizerId String      @map("organizer_id")

  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Relations
  organizer   User        @relation("EventOrganizer", fields: [organizerId], references: [id])
  venue       Venue?      @relation(fields: [venueId], references: [id])
  tickets     Ticket[]
  orders      Order[]
  splitRule   SplitRule?

  @@index([slug])
  @@index([category])
  @@index([date])
  @@index([status])
  @@index([venueId])
  @@map("events")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

// ============================================
// TICKETS
// ============================================

model Ticket {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")

  name        String
  description String?  @db.Text
  price       Float

  // Availability
  quantity    Int
  sold        Int      @default(0)

  // Sales period
  salesStart  DateTime @map("sales_start")
  salesEnd    DateTime @map("sales_end")

  // Features (JSON array of strings)
  features    String[] @default([])

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  ticketInstances TicketInstance[]

  @@index([eventId])
  @@map("tickets")
}

// ============================================
// ORDERS
// ============================================

model Order {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  eventId       String        @map("event_id")

  // Pricing
  subtotal      Float
  discount      Float         @default(0)
  total         Float

  // Payment
  paymentMethod String        @map("payment_method")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  paymentId     String?       @map("payment_id")

  // Status
  status        OrderStatus   @default(PENDING)

  // Coupon
  couponCode    String?       @map("coupon_code")

  createdAt     DateTime      @default(now()) @map("created_at")
  paidAt        DateTime?     @map("paid_at")

  // Relations
  user          User          @relation(fields: [userId], references: [id])
  event         Event         @relation(fields: [eventId], references: [id])
  items         OrderItem[]
  splitTransactions SplitTransaction[]

  @@index([userId])
  @@index([eventId])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  ticketId   String   @map("ticket_id")

  quantity   Int
  price      Float

  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  ticketInstances TicketInstance[]

  @@map("order_items")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// ============================================
// TICKET INSTANCES (Individual Tickets)
// ============================================

model TicketInstance {
  id          String   @id @default(uuid())
  orderItemId String   @map("order_item_id")
  ticketId    String   @map("ticket_id")

  // QR Code
  qrCode      String   @unique @map("qr_code")
  qrCodeData  String   @db.Text @map("qr_code_data") // Encrypted data

  // Check-in
  checkedIn   Boolean  @default(false) @map("checked_in")
  checkedInAt DateTime? @map("checked_in_at")

  // Transfer
  transferredTo String? @map("transferred_to")
  transferredAt DateTime? @map("transferred_at")

  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  ticket      Ticket    @relation(fields: [ticketId], references: [id])

  @@index([qrCode])
  @@map("ticket_instances")
}

// ============================================
// CART (Session-based)
// ============================================

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @map("user_id") // Null for guest carts
  sessionId String?    @unique @map("session_id")

  expiresAt DateTime   @map("expires_at")
  createdAt DateTime   @default(now()) @map("created_at")

  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  ticketId  String   @map("ticket_id")

  quantity  Int

  createdAt DateTime @default(now()) @map("created_at")

  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

// ============================================
// COUPONS
// ============================================

model Coupon {
  id          String       @id @default(uuid())
  code        String       @unique
  description String?

  // Discount
  discountType DiscountType @map("discount_type")
  discountValue Float       @map("discount_value")

  // Limits
  maxUses     Int?         @map("max_uses")
  usedCount   Int          @default(0) @map("used_count")

  // Validity
  validFrom   DateTime     @map("valid_from")
  validUntil  DateTime     @map("valid_until")

  // Restrictions
  eventId     String?      @map("event_id")
  minPurchase Float?       @map("min_purchase")

  active      Boolean      @default(true)

  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("coupons")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ============================================
// SPLIT PAYMENT - Pagamento Dividido
// ============================================

// Conta do Organizador para receber pagamentos
model OrganizerAccount {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")

  // Status de verificação
  verified        Boolean  @default(false)
  verifiedAt      DateTime? @map("verified_at")

  // Dados bancários
  bankCode        String?  @map("bank_code")
  bankName        String?  @map("bank_name")
  accountType     AccountType? @map("account_type")
  accountNumber   String?  @map("account_number")
  accountDigit    String?  @map("account_digit")
  agencyNumber    String?  @map("agency_number")
  agencyDigit     String?  @map("agency_digit")

  // Dados do titular
  holderName      String?  @map("holder_name")
  holderDocument  String?  @map("holder_document") // CPF ou CNPJ
  holderType      HolderType? @map("holder_type")

  // IDs externos de gateways de pagamento
  stripeAccountId     String? @unique @map("stripe_account_id")
  pagarmeRecipientId  String? @unique @map("pagarme_recipient_id")
  mercadoPagoUserId   String? @unique @map("mercadopago_user_id")
  asaasWalletId       String? @unique @map("asaas_wallet_id")

  // Saldo disponível (calculado)
  availableBalance    Float   @default(0) @map("available_balance")
  pendingBalance      Float   @default(0) @map("pending_balance")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  splitRules      SplitRule[]
  payouts         Payout[]
  transactions    SplitTransaction[]

  @@map("organizer_accounts")
}

enum AccountType {
  CHECKING    // Conta corrente
  SAVINGS     // Poupança
}

enum HolderType {
  INDIVIDUAL  // Pessoa física
  COMPANY     // Pessoa jurídica
}

// Regras de divisão para cada evento
model SplitRule {
  id              String   @id @default(uuid())
  eventId         String   @unique @map("event_id")
  organizerAccountId String @map("organizer_account_id")

  // Porcentagens (devem somar 100%)
  platformPercentage   Float @map("platform_percentage") // Ex: 10%
  organizerPercentage  Float @map("organizer_percentage") // Ex: 90%

  // Valor fixo adicional da plataforma (opcional)
  platformFixedFee     Float @default(0) @map("platform_fixed_fee")

  // Status
  active          Boolean  @default(true)

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizerAccount OrganizerAccount @relation(fields: [organizerAccountId], references: [id])
  transactions    SplitTransaction[]

  @@map("split_rules")
}

// Transações de divisão (registro de cada split)
model SplitTransaction {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  splitRuleId     String   @map("split_rule_id")
  organizerAccountId String @map("organizer_account_id")

  // Valores
  totalAmount     Float    @map("total_amount")
  platformAmount  Float    @map("platform_amount")
  organizerAmount Float    @map("organizer_amount")
  platformFee     Float    @default(0) @map("platform_fee")

  // Status
  status          SplitStatus @default(PENDING)

  // Referências externas
  externalId      String?  @map("external_id") // ID no gateway de pagamento

  createdAt       DateTime @default(now()) @map("created_at")
  processedAt     DateTime? @map("processed_at")

  // Relations
  order           Order    @relation(fields: [orderId], references: [id])
  splitRule       SplitRule @relation(fields: [splitRuleId], references: [id])
  organizerAccount OrganizerAccount @relation(fields: [organizerAccountId], references: [id])

  @@index([orderId])
  @@index([organizerAccountId])
  @@index([status])
  @@map("split_transactions")
}

enum SplitStatus {
  PENDING     // Aguardando pagamento ser confirmado
  PROCESSING  // Processando divisão
  COMPLETED   // Divisão concluída
  FAILED      // Falha na divisão
  REFUNDED    // Estornado
}

// Saques dos organizadores
model Payout {
  id              String   @id @default(uuid())
  organizerAccountId String @map("organizer_account_id")

  // Valores
  amount          Float
  fee             Float    @default(0) // Taxa de saque se houver
  netAmount       Float    @map("net_amount") // Valor líquido

  // Status
  status          PayoutStatus @default(PENDING)

  // Método de saque
  payoutMethod    PayoutMethod @map("payout_method")

  // Dados bancários no momento do saque (snapshot)
  bankCode        String?  @map("bank_code")
  accountNumber   String?  @map("account_number")
  agencyNumber    String?  @map("agency_number")

  // Referências externas
  externalId      String?  @map("external_id")

  // Datas
  requestedAt     DateTime @default(now()) @map("requested_at")
  processedAt     DateTime? @map("processed_at")
  completedAt     DateTime? @map("completed_at")
  failedAt        DateTime? @map("failed_at")
  failureReason   String?  @map("failure_reason")

  // Relations
  organizerAccount OrganizerAccount @relation(fields: [organizerAccountId], references: [id])

  @@index([organizerAccountId])
  @@index([status])
  @@map("payouts")
}

enum PayoutStatus {
  PENDING     // Solicitado, aguardando processamento
  PROCESSING  // Em processamento
  COMPLETED   // Concluído
  FAILED      // Falhou
  CANCELLED   // Cancelado
}

enum PayoutMethod {
  BANK_TRANSFER   // Transferência bancária (TED/DOC)
  PIX             // PIX
}

// ============================================
// EVENT REMINDERS
// ============================================

model EventReminder {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  eventId     String   @map("event_id")
  userId      String   @map("user_id")

  // Reminder type
  reminderType ReminderType @map("reminder_type")

  // Status
  sentAt      DateTime @default(now()) @map("sent_at")

  @@unique([orderId, reminderType])
  @@index([eventId])
  @@index([userId])
  @@map("event_reminders")
}

enum ReminderType {
  HOURS_24   // 24 hours before
  HOURS_2    // 2 hours before
}

// Log de auditoria para operações financeiras
model AuditLog {
  id              String   @id @default(uuid())

  // Entidade afetada
  entityType      String   @map("entity_type") // 'order', 'payout', 'split_transaction', etc.
  entityId        String   @map("entity_id")

  // Ação
  action          String   // 'create', 'update', 'delete', 'process', etc.

  // Usuário que realizou a ação
  userId          String?  @map("user_id")

  // Dados
  previousData    Json?    @map("previous_data")
  newData         Json?    @map("new_data")
  metadata        Json?    // Informações adicionais

  // IP e User Agent
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")

  createdAt       DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
