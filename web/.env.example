# ===========================================
# CONFIGURAÇÃO DA APLICAÇÃO WEB (NEXT.JS)
# ===========================================

# URL da API do backend
# Em desenvolvimento: use o endereço local onde o backend está rodando
# Em produção: use a URL pública da sua API
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001/api

# Nome do site (usado em títulos, meta tags, etc)
NEXT_PUBLIC_SITE_NAME=Lumera

# URL do site (usado para links canônicos, compartilhamento social, etc)
# Em desenvolvimento: use localhost com a porta do Next.js (3003 neste projeto)
# Em produção: use o domínio público do seu site
NEXT_PUBLIC_SITE_URL=http://localhost:3003


# ===========================================
# CONFIGURAÇÃO DO SENTRY (MONITORAMENTO DE ERROS)
# ===========================================
# Monitora erros em produção e ajuda a debugar problemas
# Para instalar: npm install @sentry/nextjs

# DSN do Sentry para o cliente (browser)
# Obtenha em https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project

# DSN do Sentry para o servidor (Node.js)
# Geralmente é o mesmo DSN, mas pode ser diferente se você tiver projetos separados
SENTRY_DSN=https://your-dsn@sentry.io/project

# Configuração para upload de source maps (opcional, mas recomendado para produção)
# Obtenha em https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=your-auth-token
SENTRY_ORG=your-organization-slug
SENTRY_PROJECT=your-project-slug

# Versão da aplicação (usado para rastrear erros por release)
NEXT_PUBLIC_APP_VERSION=1.0.0


# ===========================================
# OBSERVAÇÕES IMPORTANTES
# ===========================================

# 1. Todas as variáveis que começam com NEXT_PUBLIC_ são expostas no browser
#    Nunca coloque informações sensíveis (senhas, tokens secretos) nessas variáveis

# 2. Para variáveis privadas (que não devem ser expostas no browser),
#    use variáveis sem o prefixo NEXT_PUBLIC_

# 3. Após modificar este arquivo, reinicie o servidor de desenvolvimento
#    (npm run dev ou yarn dev)

# 4. Em produção, configure estas variáveis no seu provedor de hospedagem
#    (Vercel, Netlify, AWS, etc) ao invés de usar o arquivo .env
